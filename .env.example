# NyayaLens Environment Variables
# -------------------------------------------------------------
# Google Gemini API Key for production GenAI legal extraction and Q&A
# Server-side only (never exposed to client browser bundles)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cryptographic Session Secret (used for signing session tokens and preventing IDOR)
# In production (NODE_ENV=production), this variable IS STRICTLY REQUIRED.
# NyayaLens will fail fast on startup if missing.
# Recommended: 64-character cryptographically random hex string
SESSION_SECRET=your_production_session_signing_secret_here

# Rate Limiting & Distributed Serverless Cache (Optional)
# If left unset, NyayaLens operates with an in-process, bounded InMemoryRateLimitStore.
# In multi-region serverless or horizontally scaled clusters, configure Upstash Redis
# to synchronize IP rate limits across all edge/serverless nodes globally.
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
# REDIS_URL=redis://default:password@your-redis-host:6379

# Node Environment
NODE_ENV=production
